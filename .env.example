# Environment configuration for Ai2 All Compress.
# Copy this file to .env.local and adjust the values before deploying.

# Public canonical URL of the site. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ai2allcompress.vercel.app

# Optional AdSense publisher ID, e.g. ca-pub-1234567890123456.
# Leave empty to hide all ad slots and avoid loading ad scripts.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Public contact address shown in the footer, contact form, and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=maidiladha59@gmail.com
